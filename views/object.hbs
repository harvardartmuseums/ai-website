{{> image_context}}
<section class="object-info-panel image-research-workspace">
  <header class="research-heading"><span class="research-label">Image research</span><h1>AI analysis of image {{display_image.imageid}}</h1><p>Image of {{object_info.title}} · Associated object {{object_info.id}}</p>{{#if image_summary.descriptions}}<p class="image-summary">{{{image_summary.descriptions}}}</p>{{/if}}</header>
  <nav class="research-tabs" aria-label="Image analysis views"><a href="#perspectives" data-research-tab="perspectives">Perspectives <span class="beta-badge">Beta</span></a><a href="#descriptions" data-research-tab="descriptions">Descriptions</a><a href="#compare" data-research-tab="compare">Compare</a><a href="#tags" data-research-tab="tags">Tags</a><a href="#other" data-research-tab="other">Other analyses</a></nav>
  <div class="content">
    {{#if selected_annotation}}
    <section class="research-source-record" id="research-source-record">
      <h2>Complete source annotation</h2>
      <p>Annotation {{selected_annotation.id}} · {{selected_annotation.source}}{{#if selected_annotation.model}} · {{selected_annotation.model}}{{/if}} · {{selected_annotation.type}}</p>
      <p class="research-note">About image {{display_image.imageid}}{{#if selected_annotation.createdate}} · Generated {{selected_annotation.createdate}}{{/if}}</p>
      <div class="research-source-body">{{selected_annotation.body}}</div>
    </section>
    {{/if}}
<div id="research-perspectives" data-research-panel="perspectives"><section class="ai-section attention-section" id="attention-section">
          <h2>AI perspectives on this image</h2>
          <p class="attention-intro">Explore patterns across providers, then inspect the descriptions behind them.</p>

          <div class="attention-card attention-card--ai" id="ai-perspectives-section">
            <div class="attention-card-heading"></div>
            <div id="perspectives-panel">
              <div id="perspectives-loading"><p class="perspectives-status">Loading…</p></div>
              <div id="perspectives-error" style="display:none;"><p class="perspectives-status perspectives-status--error"></p></div>
              <div id="perspectives-content" style="display:none;">

                <div id="perspectives-radar" class="perspectives-block" style="display:none;">
                  <h5 id="radar-heading" class="perspectives-block-heading">What models describe</h5>
                  <p class="perspectives-divergence-intro">Breadth of descriptive vocabulary across eight dimensions</p>
                  <div class="radar-controls">
                    <label for="radar-view">Compare by</label>
                    <select id="radar-view" class="compare-select"><option value="outputs">Models · individual outputs</option><option value="providers">Providers · pooled vocabulary</option></select>
                    <label for="radar-search">Find a model or provider</label>
                    <input id="radar-search" type="search" placeholder="Model, provider, date, or annotation ID">
                    <label for="radar-add">Add a series</label><select id="radar-add" class="compare-select"></select>
                  </div>
                  <p id="radar-view-note" class="research-note"></p>
                  <details class="radar-method"><summary>How this is calculated</summary><p>Models shows one description per series, identified by its annotation ID. Providers shows the union of vocabulary across each provider’s descriptions. Both views use the largest provider union per dimension from all AI outputs for this image. Hiding series keeps the scale fixed. Word counts indicate opportunities to match vocabulary; larger shapes do not indicate accuracy or quality.</p><p>The optional object wall label never sets the AI scale. Reference values above the AI maximum are marked at the chart edge; raw counts remain available below. A dimension with no matched AI vocabulary has no relative scale.</p></details>
                  <div class="radar-layout">
                    <div id="perspectives-radar-chart"></div>
                    <div id="perspectives-radar-legend" class="radar-legend"></div>
                  </div>
                  <label for="radar-dimension">Explore a dimension</label><select id="radar-dimension" class="compare-select"></select>
                  <div id="radar-evidence" aria-live="polite"></div>
                </div>


                <div id="perspectives-chips" class="perspectives-chips"></div>

                <details class="research-perspective-detail"><summary>What the AIs noticed</summary><div id="ai-observations-section" class="perspectives-block">
                  <h5 class="perspectives-block-heading">What the AIs noticed</h5>
                  <p class="perspectives-divergence-intro">Phrases extracted from AI-generated descriptions, grouped by category. No agreement threshold — everything the models mentioned, organised for browsing.</p>
                  <div id="observations-categories"></div>
                </div></details>

                <details class="research-perspective-detail"><summary>Mood palette</summary><div id="perspectives-mood" class="perspectives-block" style="display:none;">
                  <h5 class="perspectives-block-heading">Mood palette</h5>
                  <p class="perspectives-divergence-intro">Expressive and interpretive language drawn from AI descriptions — how the models characterize atmosphere, feeling, and tone rather than what they identify.</p>
                  <div id="perspectives-mood-list" class="perspectives-mood-list"></div>
                </div></details>

                <details class="research-perspective-detail"><summary>Shared vocabulary</summary><div id="perspectives-agreement" class="perspectives-block">
                  <h5 class="perspectives-block-heading">Shared vocabulary across providers</h5>
                  <p class="perspectives-divergence-intro">Repeated terms and conservative linguistic equivalents. Related concepts retain separate support counts.</p><div id="perspectives-concepts-list" class="perspectives-concepts-list"></div>
                  <p class="perspectives-type-note"><strong>Descriptive</strong> concepts reflect what AI services observe visually—shapes, objects, settings. <strong>Interpretive</strong> concepts reflect genre, format, or subject-matter readings, which are more subjective and more likely to vary between services.</p>
                </div></details>

                <details class="research-perspective-detail"><summary>Thematic terms</summary><div id="perspectives-thematic" class="perspectives-block" style="display:none;">
                  <h5 class="perspectives-block-heading">Thematic terms — what the AI descriptions are about</h5>
                  <p class="perspectives-divergence-intro">Words that appear consistently across multiple AI-generated descriptions, weighted by how distinctive they are to this image. These reflect conceptual and thematic content rather than observed features. Treat them as prompts for inquiry, not confirmed readings.</p>
                  <div id="perspectives-thematic-list" class="perspectives-thematic-list"></div>
                </div></details>

                <details class="research-perspective-detail"><summary>How descriptions relate</summary><div id="perspectives-relationships" class="perspectives-block" style="display:none;">
                  <h5 class="perspectives-block-heading">How descriptions relate</h5>
                  <p class="perspectives-divergence-intro">Explore exact terms within curated concept families. Shared family membership does not imply the same meaning or agreement. Excerpts preserve the context of each mention.</p>
                  <div id="perspectives-relationships-list" class="perspectives-relationships-list"></div>
                </div></details>

                <p class="perspectives-footer-note">This tool currently processes English-language AI annotations only.</p>
              </div>
            </div>
          </div>
        </section></div>
<div id="research-descriptions" data-research-panel="descriptions">{{#unless ai_sorted.descriptions}}<p>No model descriptions are available for this image.</p>{{/unless}}<section class="ai-section" id="descriptions">
              <h3>Descriptions <a class="compare-link" href="#compare"><i class="fa fa-columns"></i> Compare</a></h3>
              <div class="desc-toolbar">
                <div class="desc-toolbar-section">
                  <div class="desc-toolbar-controls">
                    <div class="desc-toolbar-control-group">
                      <label class="desc-toolbar-label" for="desc-source-select">Provider</label>
                      <select id="desc-source-select" class="compare-select desc-sort-select"></select>
                      <label class="desc-toolbar-label" for="desc-model-select">Model</label><select id="desc-model-select" class="compare-select desc-sort-select"></select>
                      <label class="desc-toolbar-label" for="desc-length-select">Length</label>
                      <select id="desc-length-select" class="compare-select desc-sort-select"></select>
                      <label class="desc-toolbar-label" for="desc-sort-select">Sort</label>
                      <select id="desc-sort-select" class="compare-select desc-sort-select">
                        <option value="source-asc">source A–Z</option>
                        <option value="words-desc">most words</option>
                        <option value="words-asc">fewest words</option>
                        <option value="date-desc">newest generated</option>
                        <option value="date-asc">oldest generated</option>
                        <option value="model-desc">newest model</option>
                        <option value="model-asc">oldest model</option>
                        <option value="tokens-desc">most tokens</option>
                        <option value="tokens-asc">fewest tokens</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="desc-toolbar-section">
                  <div class="desc-toolbar-controls">
                    <div class="desc-toolbar-control-group">
                      <label class="desc-toolbar-label" for="desc-highlight-input">Highlight</label>
                      <input type="search" id="desc-highlight-input" class="desc-highlight-input" placeholder="Search text…">
                      <span id="desc-highlight-count" class="desc-highlight-count"></span>
                    </div>
                    <div class="desc-toolbar-control-group">
                      <button class="quickbar-btn" id="desc-density-toggle">Show language statistics</button>
                      <button class="quickbar-btn" id="desc-cost-toggle">Show tokens</button>
                    </div>
                  </div>
                </div>
              </div>
              <p id="desc-results-count" role="status"></p><p id="desc-filter-empty" hidden>No descriptions match these filters.</p><button type="button" class="quickbar-btn" id="desc-reset">Reset filters</button><div id="desc-cards-container">
              {{#each ai_sorted.descriptions}}
                {{#each descriptions}}
                  <div class="desc-card" data-annotation-id="{{id}}" data-model="{{#if display_model}}{{display_model}}{{else}}{{model}}{{/if}}" data-source-raw="{{source}}" data-wordcount="{{stats.total}}" data-source="{{../source}}" data-date="{{createdate}}" data-model-released="{{model_released}}" data-total-tokens="{{#if cost}}{{cost.total}}{{/if}}" data-default-index="{{@../index}}-{{@index}}">
                    <div class="desc-card-header"><button type="button" class="quickbar-btn research-compare-output" data-annotation-id="{{id}}">Compare with…</button>
                      <span class="desc-card-title">{{#if display_model}}{{display_model}}{{else}}{{model}}{{/if}}<span class="desc-card-source">{{../source}}</span></span>
                    </div>
                    <div class="desc-card-body">
                      <div class="desc-card-date-col">
                        {{#if age}}<span class="header-age desc-card-age">Generated {{age}}</span>{{/if}}
                        <span class="desc-card-date">({{createdate}})</span>
                      </div>
                      <div class="desc-card-text">
                        {{#if body}}
                          {{{markdown body}}}
                        {{else}}
                          <p class="desc-empty">No description written</p>
                        {{/if}}
                      </div>
                      {{#if stats}}
                      <div class="panel-stats-section panel-stats-section--density desc-card-density">
                        <span class="sidebar-group-label panel-stats-label">Information Density</span>
                        <div class="panel-stats">
                          <span class="panel-stat" title="Content words / total words">Lexical density <strong>{{stats.lexicalDensity}}%</strong></span>
                          <span class="panel-stat" title="Unique words / total words">Vocab diversity <strong>{{stats.ttr}}%</strong></span>
                          <span class="panel-stat" title="Words appearing once / total words">Specificity <strong>{{stats.hapaxRatio}}%</strong></span>
                          <span class="panel-stat" title="Average words per sentence">Avg sentence <strong>{{stats.avgSentLen}} words</strong></span>
                          <span class="panel-stat" title="Total word count">Length <strong>{{stats.total}} words</strong></span>
                        </div>
                      </div>
                      {{/if}}
                      <div class="panel-stats-section panel-stats-section--cost desc-card-cost">
                        <span class="sidebar-group-label panel-stats-label">Token usage</span>
                        <div class="panel-stats panel-stats--tokens">
                        {{#if cost}}
                          <span class="panel-stat" title="Tokens sent to the model">Input tokens <strong>{{cost.input}}</strong></span>
                          <span class="panel-stat" title="Tokens generated by the model">Output tokens <strong>{{cost.output}}</strong></span>
                          {{#if cost.total}}<span class="panel-stat" title="Total tokens used">Total tokens <strong>{{cost.total}}</strong></span>{{/if}}
                        {{else}}
                          <span class="panel-stat" title="Tokens sent to the model">Input tokens <strong>?</strong></span>
                          <span class="panel-stat" title="Tokens generated by the model">Output tokens <strong>?</strong></span>
                          <span class="panel-stat" title="Total tokens used">Total tokens <strong>?</strong></span>
                        {{/if}}
                        </div>
                      </div>
                    </div>
                  </div>
                {{/each}}
              {{/each}}
              </div>{{! /#desc-cards-container }}
          </section></div>
<section id="research-compare" data-research-panel="compare"><h2>Compare descriptions</h2><p class="research-note">Model outputs describe image {{display_image.imageid}}. Human references identify whether they describe this image or its associated object.</p>{{> compare_workspace}}</section>
<div id="research-tags" data-research-panel="tags">{{#unless ai_sorted.tagsect}}<p>No tags are available for this image.</p>{{/unless}}<section class="ai-section">
          <h3>Tags</h3>
          <div class="tag-box">
            {{#each ai_sorted.tagsect}}
              <div class="service-tags">
                <div class="tag-heading">
                  <h4>{{source}}<br/><span>created on {{createdate}}</span></h4>
                </div>
                <div class="tag-list">
                  <table class="tag-table">
                    {{#each tags}}
                      <tr>
                        <td class="tag-body"><a href="/search/{{urlencode body}}">{{body}}</a></td>
                        <td class="tag-confidence">{{confidence}}</td>
                      </tr>
                      <tr>
                        <td colspan="2">
                          <div class="confidence-bar">
                            <div class="red-bar" style="width:{{confidence}}%"></div>
                          </div>
                        </td>
                      </tr>
                    {{/each}}
                  </table>
                </div>
              </div>
            {{/each}}
          </div>
        </section></div>
<div id="research-other" data-research-panel="other">{{#unless has_other_analysis}}<p>No other analyses are available for this image.</p>{{/unless}}{{#if ai_sorted.facesect}}<section class="ai-section">
            <h3>Face analysis</h3>
            <div class="faces-box">
              <div class="faces-toggle">
                {{#each ai_sorted.facesect}}
                  <div class="face-subsect">
                    <div class="faces-sources">
                      <h4>{{source}}</h4>
                    </div>
                    <div class="faces-icons">
                      {{#each faces}}
                        <button type="button" aria-label="Inspect detected face" id="{{id}}face-button" onclick="toggleface('{{id}}')"><div id="{{id}}icon" class="face-images" style="background-image:url({{imageFragmentURL}})"></div></button>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}
              </div>
              <div class="face-info">
                {{#each ai_sorted.facesect}}
                  {{#each faces}}
                    <div class="face-info-box" id="{{id}}">
                      <div class="face-content">
                        <div class="face-image">
                          <img src="{{imageFragmentURL}}" alt="Detected image region">
                        </div>
                        <div class="face-text">
                          <h4>{{source}}</h4>
                          <table>
                            {{#each sorted_raw}}
                              <tr>
                                <td class="face-text-type">{{type}}</td>
                                <td class="face-text-body">{{body}}</td>
                              </tr>
                            {{/each}}
                          </table>
                        </div>
                      </div>
                    </div>
                  {{/each}}
                {{/each}}
              </div>
            </div>
          </section>{{/if}}{{#if ai_sorted.featuresect}}<section class="ai-section">
            <h3>Feature analysis</h3>
            <div class="faces-box">
              <div class="faces-toggle">
                {{#each ai_sorted.featuresect}}
                  <div class="face-subsect">
                    <div class="faces-sources">
                      <h4>{{source}}</h4>
                    </div>
                    <div class="faces-icons">
                      {{#isEmpty features}}
                        <div><p>No features identified</p></div>
                      {{else}}
                        {{#each features}}
                            <div class="feature-icon-title">{{@key}}</div>
                            <div>
                            {{#each this}}
                              <button type="button" aria-label="Inspect detected feature" id="{{id}}feature-button" onclick="togglefeature('{{id}}')">
                              <div class="feature-images" id="{{id}}featureicon" style="background-image:url({{imageFragmentURL}})"></div>
                              </button>
                            {{/each}}
                            </div>
                        {{/each}}
                      {{/isEmpty}}
                  </div>
                </div>
                {{/each}}
              </div>
              <div class="face-info">
                  {{#each ai_sorted.featuresect}}
                    {{#each features}}
                    {{#each this}}
                      <div class="feature-info-box" id="{{id}}">
                        <div class="feature-content">
                          <div class="feature-image">
                            <img class="feature-slide" src="{{imageFragmentURL}}" alt="Detected image region">
                          </div>
                          <div class="feature-text">
                            <h4>{{source}}</h4>
                            <table>
                              <tr>
                                <td class="tag-body"><a href="/feature/{{urlencode body}}">{{body}}</a></td>
                                <td class="tag-confidence">{{confidence}}%</td>
                              </tr>
                              <tr>
                                <td colspan="2">
                                  <div class="confidence-bar">
                                    <div class="red-bar" style="width:{{confidence}}%"></div>
                                  </div>
                                <td>
                              </tr>
                            </table>
                          </div>
                        </div>
                      </div>
                      {{/each}}
                    {{/each}}
                  {{/each}}
              </div>
            </div>
          </section>{{/if}}{{#if ai_sorted.categories}}<section class="ai-section">
            <h3>Categories</h3>
            <div class="content-box captions-colors-box">
              {{#each ai_sorted.categories}}
              <div class="captions-colors-box-content">
                <div class="captions-colors-head">
                  <h4>{{source}}<br/><span style="font-size: small;">created on {{createdate}}</span></h4>
                </div>
                {{#isEmpty categories}}
                <p>No categories identified</p>
                {{else}}
                <table class="captions-table">
                  {{#each categories}}
                    <tr>
                      <td><a href="/category/{{urlencode body}}">{{body}}</a></td>
                      <td class="tag-confidence">{{confidence}}%</td>
                    </tr>
                    <tr>
                      <td colspan="2">
                        <div class="confidence-bar">
                          <div class="red-bar" style="width:{{confidence}}%"></div>
                        </div>
                      </td>
                    </tr>
                  {{/each}}
                </table>
                {{/isEmpty}}
              </div>
              {{/each}}
            </div>
          </section>{{/if}}{{#if ai_sorted.captions}}<section class="ai-section">
            <h3>Captions</h3>
              <div class="content-box captions-colors-box">
              {{#each ai_sorted.captions}}
              <div class="captions-colors-box-content">
                <div class="captions-colors-head">
                  <h4>{{source}}<br/><span style="font-size: small;">created {{#if captions.0.model}}by {{captions.0.model}} {{/if}}on {{createdate}}</span></h4>
                </div>
                <table class="captions-table">
                  {{#each captions}}
                    <tr>
                      <td><a href="/search/{{urlencode body}}">{{body}}</a></td>
                      <td class="tag-confidence">{{confidence}}%</td>
                    </tr>
                    <tr>
                      <td colspan="2">
                        <div class="confidence-bar">
                          <div class="red-bar" style="width:{{confidence}}%"></div>
                        </div>
                      </td>
                    </tr>
                  {{/each}}
                </table>
              </div>
              {{/each}}
              </div>
          </section>{{/if}}{{#if ai_sorted.textsect}}<section class="ai-section">
            <h3>Text analysis</h3>
            <div class="content-box text-box">
                {{#each ai_sorted.textsect}}
                  <div class="text-service-sect">
                    <div class="text-head">
                      <h4>{{source}}</h4>
                    </div>
                    <div class="text-tags-list">
                      {{#each text}}
                        <div class="text-tag">
                          <img class="text-image" src="{{imageFragmentURL}}" alt="Image region containing detected text">
                          <div class="text-icon-title">{{body}}</div>
                        </div>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}
            </div>
          </section>{{/if}}{{#if object_info.colors}}<section class="ai-section">
          <h3>Object color palette</h3><p class="research-note">Colors from the museum object record; not a model annotation of the selected image.</p>
          <div class="content-box captions-colors-box">
            <div class="captions-colors-box-content" style="height:25px;">
           {{#each object_info.colors}}
              <div style="float:left;background:{{color}};height:25px;width:25px;"></div>
           {{/each}}
           </div>
           </div>
        </section>{{/if}}</div>
</div></section>
<script src="/javascripts/openseadragon/openseadragon.min.js"></script>

<script type="text/javascript">
  var viewer = OpenSeadragon({
      id: "openseadragon1",
      prefixUrl: "/javascripts/openseadragon/images/",
      toolbar: "image-toolbar",
      zoomInButton: "zoom-in",
      zoomOutButton: "zoom-out",
      homeButton: "zoom-home",
      {{#if object_info.imagepermissionlevel}}
      maxZoomLevel: 1,
      {{/if}}
      tileSources: [
        "{{display_image.baseimageurl}}/info.json"
      ]
  });

  var descDensityVisible = false;
  var descCostVisible = false;
  var originalCardHTML = new Map();

  function allCards() {
    return Array.from(document.querySelectorAll('#desc-cards-container .desc-card'));
  }

  function applyDescVisibility() {
    var section = document.getElementById('descriptions');
    if (!section) return;
    section.querySelectorAll('.panel-stats-section--density').forEach(function(el) {
      el.style.display = descDensityVisible ? '' : 'none';
    });
    section.querySelectorAll('.panel-stats-section--cost').forEach(function(el) {
      el.style.display = descCostVisible ? '' : 'none';
    });
  }

  function applyDescFilter() {
    var lengthSel = document.getElementById('desc-length-select');
    var sourceSel = document.getElementById('desc-source-select');
    var lengthVal = lengthSel ? lengthSel.value : 'any';
    var sourceVal = sourceSel ? sourceSel.value : 'all';
    var modelSel = document.getElementById('desc-model-select');
    var modelVal = modelSel ? modelSel.value : 'all';
    var ranges = { short: [0, 100], medium: [101, 300], long: [301, Infinity] };
    var minVal = lengthVal !== 'any' ? ranges[lengthVal][0] : 0;
    var maxVal = lengthVal !== 'any' ? ranges[lengthVal][1] : Infinity;
    allCards().forEach(function(card) {
      var words = parseInt(card.dataset.wordcount, 10) || 0;
      var srcMatch = (sourceVal === 'all' || card.dataset.source === sourceVal) && (modelVal === 'all' || card.dataset.model === modelVal);
      card.style.display = (srcMatch && words >= minVal && words <= maxVal) ? '' : 'none';
    });
  }

  function applySort() {
    var select = document.getElementById('desc-sort-select');
    var container = document.getElementById('desc-cards-container');
    if (!select || !container) return;
    var cards = allCards();
    var val = select.value;
    cards.sort(function(a, b) {
      var numeric = {words: 'wordcount', tokens: 'totalTokens'};
      var parts = val.split('-'), field = numeric[parts[0]], direction = parts[1] === 'desc' ? -1 : 1;
      var av, bv;
      if (field) {
        av = a.dataset[field] === '' ? NaN : Number(a.dataset[field]);
        bv = b.dataset[field] === '' ? NaN : Number(b.dataset[field]);
      } else if (parts[0] === 'date' || parts[0] === 'model') {
        field = parts[0] === 'date' ? 'date' : 'modelReleased';
        av = Date.parse(a.dataset[field]); bv = Date.parse(b.dataset[field]);
      } else return (a.dataset.source || '').localeCompare(b.dataset.source || '');
      if (!Number.isFinite(av)) return Number.isFinite(bv) ? 1 : 0;
      if (!Number.isFinite(bv)) return -1;
      return (av - bv) * direction;
    });
    cards.forEach(function(c) { container.appendChild(c); });
  }

  function applyHighlight() {
    var query = (document.getElementById('desc-highlight-input') || {}).value || '';
    var countEl = document.getElementById('desc-highlight-count');
    query = query.trim();
    var totalHits = 0;
    allCards().forEach(function(card) {
      var textEl = card.querySelector('.desc-card-text');
      if (!textEl) return;
      if (!originalCardHTML.has(card)) originalCardHTML.set(card, textEl.innerHTML);
      textEl.innerHTML = originalCardHTML.get(card);
      if (!query || card.style.display === 'none') return;
      var re;
      try { re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'); }
      catch(e) { return; }
      var walker = document.createTreeWalker(textEl, NodeFilter.SHOW_TEXT, null, false);
      var nodes = [];
      var node;
      while ((node = walker.nextNode())) nodes.push(node);
      nodes.forEach(function(tn) {
        var matches = tn.nodeValue.match(re);
        if (!matches) return;
        totalHits += matches.length;
        var fragment = document.createDocumentFragment();
        var cursor = 0, match;
        re.lastIndex = 0;
        while ((match = re.exec(tn.nodeValue))) {
          fragment.appendChild(document.createTextNode(tn.nodeValue.slice(cursor, match.index)));
          var mark = document.createElement('mark'); mark.className = 'desc-highlight'; mark.textContent = match[0];
          fragment.appendChild(mark); cursor = match.index + match[0].length;
        }
        fragment.appendChild(document.createTextNode(tn.nodeValue.slice(cursor)));
        tn.parentNode.replaceChild(fragment, tn);
      });
    });
    if (countEl) countEl.textContent = query ? totalHits + (totalHits === 1 ? ' match' : ' matches') : '';
  }

  function buildFilterSelects() {
    // Length select — compute actual min/max per band from card data
    var counts = allCards().map(function(c) { return parseInt(c.dataset.wordcount, 10) || 0; });
    var inBand = function(min, max) { return counts.filter(function(w) { return w >= min && (max === Infinity || w <= max); }); };
    var shortCounts  = inBand(0,   100);
    var mediumCounts = inBand(101, 300);
    var longCounts   = inBand(301, Infinity);
    var bandLabel = function(label, bCounts) {
      if (!bCounts.length) return null;
      var lo = Math.min.apply(null, bCounts);
      var hi = Math.max.apply(null, bCounts);
      return label + ' (' + lo + (lo !== hi ? '–' + hi : '') + ' words)';
    };
    var lengthSel = document.getElementById('desc-length-select');
    if (lengthSel) {
      var anyOpt = document.createElement('option');
      anyOpt.value = 'any'; anyOpt.textContent = 'any length'; lengthSel.appendChild(anyOpt);
      [['short', shortCounts], ['medium', mediumCounts], ['long', longCounts]].forEach(function(pair) {
        var lbl = bandLabel(pair[0].charAt(0).toUpperCase() + pair[0].slice(1), pair[1]);
        if (!lbl) return;
        var opt = document.createElement('option'); opt.value = pair[0]; opt.textContent = lbl;
        lengthSel.appendChild(opt);
      });
      lengthSel.addEventListener('change', applyDescFilter);
    }

    var modelSel = document.getElementById('desc-model-select');
    if (modelSel) {
      var allModels = document.createElement('option'); allModels.value = 'all'; allModels.textContent = 'any model'; modelSel.appendChild(allModels);
      Array.from(new Set(allCards().map(function(card) { return card.dataset.model; }).filter(Boolean))).sort().forEach(function(model) {
        var option = document.createElement('option'); option.value = model; option.textContent = model; modelSel.appendChild(option);
      });
      modelSel.addEventListener('change', applyDescFilter);
    }

    // Source select — single pick
    var sourceSel = document.getElementById('desc-source-select');
    if (sourceSel) {
      var allOpt = document.createElement('option'); allOpt.value = 'all'; allOpt.textContent = 'any source';
      sourceSel.appendChild(allOpt);
      var sources = [];
      allCards().forEach(function(card) {
        var s = card.dataset.source;
        if (s && sources.indexOf(s) === -1) sources.push(s);
      });
      sources.sort().forEach(function(src) {
        var opt = document.createElement('option'); opt.value = src; opt.textContent = src;
        sourceSel.appendChild(opt);
      });
      sourceSel.addEventListener('change', applyDescFilter);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    loadPerspectives();

    var firstFace = document.querySelector('button[id$="face-button"]');
    if (firstFace) firstFace.click();
    var firstFeature = document.querySelector('button[id$="feature-button"]');
    if (firstFeature) firstFeature.click();

    buildFilterSelects();
    applyDescVisibility();
    applyDescFilter();

    var sortSelect = document.getElementById('desc-sort-select');
    if (sortSelect) sortSelect.addEventListener('change', applySort);

    var highlightInput = document.getElementById('desc-highlight-input');
    if (highlightInput) highlightInput.addEventListener('input', applyHighlight);

    var densityToggle = document.getElementById('desc-density-toggle');
    if (densityToggle) {
      densityToggle.addEventListener('click', function() {
        descDensityVisible = !descDensityVisible;
        this.textContent = descDensityVisible ? 'Hide language statistics' : 'Show language statistics';
        applyDescVisibility();
      });
    }

    var costToggle = document.getElementById('desc-cost-toggle');
    if (costToggle) {
      costToggle.addEventListener('click', function() {
        descCostVisible = !descCostVisible;
        this.textContent = descCostVisible ? 'Hide tokens' : 'Show tokens';
        applyDescVisibility();
      });
    }
  }, false);

  function toggleface(id) {
      var faces = document.getElementsByClassName('face-info-box');
      for(var i = 0; i < faces.length; i++){
          faces[i].style.display = "none";
      }
      var icons = document.getElementsByClassName('face-images');
      for(var i = 0; i < icons.length; i++){
          icons[i].style.border = "none";
      }
      var div = document.getElementById(id);
      var icon = document.getElementById(id + "icon")
      div.style.display = div.style.display == "block" ? "none" : "block";
      icon.style.border = icon.style.border == "1.5px solid var(--c-orangered)" ? "none" : "1.5px solid var(--c-orangered)";
  }

  function togglefeature(id) {
      var features = document.getElementsByClassName('feature-info-box');
      for(var i = 0; i < features.length; i++){
          features[i].style.display = "none";
      }
      var icons = document.getElementsByClassName('feature-images');
      for(var i = 0; i < icons.length; i++){
          icons[i].style.border = "none";
      }
      var div = document.getElementById(id);
      var icons = document.getElementById(id + "featureicon")
      div.style.display = div.style.display == "block" ? "none" : "block";
      icons.style.border = icons.style.border == "1.5px solid var(--c-orangered)" ? "none" : "1.5px solid var(--c-orangered)";
  }

  // ---------------------------------------------------------------------------
  // AI Perspectives panel
  // ---------------------------------------------------------------------------

  var _perspectivesData    = null;
  var _perspectivesLoaded  = false;
  var _perspectivesUrl     = '/object/{{object_info.id}}/image/{{display_image.imageid}}/perspectives';

  function loadPerspectives() {
    var loading = document.getElementById('perspectives-loading');
    var error   = document.getElementById('perspectives-error');
    var content = document.getElementById('perspectives-content');

    fetch(_perspectivesUrl)
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(data) {
        _perspectivesData   = data;
        _perspectivesLoaded = true;
        loading.style.display = 'none';
        if (data.status === 'no_annotations') {
          error.querySelector('p').textContent = 'No AI annotations are available for this image.';
          error.style.display = '';
          return;
        }
        if (data.status === 'error') {
          error.querySelector('p').textContent = data.message || 'An error occurred.';
          error.style.display = '';
          return;
        }
        content.style.display = '';
        renderPerspectives(data);
      })
      .catch(function(err) {
        loading.style.display = 'none';
        error.querySelector('p').textContent = 'AI Perspectives could not be loaded.';
        error.style.display = '';
      });
  }

  function renderPerspectives(data) {
    renderChips(data);
    renderObservations(data);
    renderMoodPalette(data);
    renderCoverageRadar(data);
    renderConcepts(data);
    renderThematic(data);
    renderRelationships(data);
    renderDownloadBtn(data);
    document.querySelectorAll('.research-perspective-detail').forEach(function(detail) {
      var block = detail.querySelector('.perspectives-block');
      detail.hidden = block && block.style.display === 'none';
    });
    document.querySelectorAll('#perspectives-content div[onclick]').forEach(function(control) {
      control.setAttribute('role', 'button'); control.setAttribute('tabindex', '0');
      control.addEventListener('keydown', function(event) {
        // Nested evidence links must keep their own Enter-key navigation.
        if (event.target !== control) return;
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); control.click(); }
      });
    });
  }

  function renderChips(data) {
    var s    = data.summary || {};
    var el   = document.getElementById('perspectives-chips');
    var html = '';

    if (s.concepts_returned != null) {
      html += chip(s.concepts_returned + ' agreement concept' + (s.concepts_returned === 1 ? '' : 's'), '');
    }
    if (s.thematic_concepts_returned > 0) {
      html += chip(s.thematic_concepts_returned + ' thematic term' + (s.thematic_concepts_returned === 1 ? '' : 's'), 'Words that appear consistently across multiple AI-generated descriptions, weighted by how distinctive they are to this image.');
    }
    if (s.concept_relationships_returned > 0) {
      html += chip(s.concept_relationships_returned + ' concept famil' + (s.concept_relationships_returned === 1 ? 'y' : 'ies'), 'Curated vocabulary relationships, with supporting excerpts.');
    }
    if (s.has_text) {
      html += chip('Text in image', '');
    }
    if (s.has_faces && s.face_stats) {
      var fs = s.face_stats;
      var faceLabel;
      if (fs.min === fs.max) {
        faceLabel = 'Faces detected (' + fs.min + ' — all services agree)';
      } else {
        faceLabel = 'Faces detected (min ' + fs.min + ', max ' + fs.max + ', avg ' + fs.avg + ')';
      }
      var perServiceLines = (fs.per_service || []).map(function(p) {
        return p.source + ': ' + p.count;
      }).join(' · ');
      var faceTooltip = 'Services reporting: ' + perServiceLines + '. Face detection uses general-purpose computer vision models trained primarily on photographs. These models are known to perform unevenly across skin tones and may miss faces—or find faces where there are none—in paintings, prints, drawings, and sculptures.';
      html += chip(faceLabel, faceTooltip);
    }
    if (s.depicts_people) {
      var examples = (s.depicts_people_examples || []).join(', ');
      var peopleTooltip = 'Based on how multiple AI captions and tags refer to people or figures in the scene' + (examples ? ' (e.g., &#8216;' + examples + '&#8217;)' : '') + '. May include mythological or supernatural figures if AI services describe them this way.';
      html += chip('Depicts people — ' + (s.depicts_people_level || '') + ' agreement', peopleTooltip);
    }
    html += chip('English annotations only', '');
    el.innerHTML = html;
  }

  function chip(label, tooltip) {
    if (tooltip) {
      return '<span class="perspectives-chip" title="' + escHtml(tooltip) + '">' + escHtml(label) + ' <span class="perspectives-chip-info">ⓘ</span></span>';
    }
    return '<span class="perspectives-chip">' + escHtml(label) + '</span>';
  }

  function evidenceLink(e) {
    return e.url ? '<a class="perspectives-evidence-link" href="' + escHtml(e.url) + '">Read complete annotation</a>' : '';
  }
  function evidenceHTML(e) {
    var label = e.source + (e.display_model && e.display_model !== e.source ? ' — ' + e.display_model : '');
    return '<span class="perspectives-snippet">' + escHtml(label) + ': "' + escHtml(e.snippet || e.text) + '"</span>' + evidenceLink(e);
  }

  function renderConcepts(data) {
    var list = document.getElementById('perspectives-concepts-list');
    var concepts = data.concepts || [];
    if (concepts.length === 0) {
      list.innerHTML = '<p class="perspectives-empty">No shared vocabulary meets the provider and annotation thresholds. Explore concept families and individual observations below.</p>';
      return;
    }
    var html = '';
    for (var i = 0; i < concepts.length; i++) {
      var c = concepts[i];
      var typeBadge    = '<span class="perspectives-badge perspectives-badge--' + c.concept_type + '">' + capitalize(c.concept_type) + '</span>';
      var levelBadge   = '<span class="perspectives-badge perspectives-badge--' + c.agreement_level + '">' + capitalize(c.agreement_level) + '</span>';
      var peopleBadge  = c.people_related ? '<span class="perspectives-badge perspectives-badge--people">People-related</span>' : '';
      var snippets = (c.example_annotations || []).map(function(e) {
        return evidenceHTML(e);
      }).join('');
      var variantHtml = '';
      if (c.variants && c.variants.length > 1) {
        var variantParts = c.variants.map(function(v) {
          return '<span class="perspectives-variant">' + escHtml(v.term)
               + ' <span class="perspectives-variant-sources">(' + v.services.map(escHtml).join(', ') + ')</span></span>';
        });
        variantHtml = '<div class="perspectives-variants">Called: ' + variantParts.join(', ') + '</div>';
      }
      var hasDetail = snippets || variantHtml;
      html += '<div class="perspectives-concept' + (hasDetail ? ' perspectives-concept--expandable' : '') + '"' + (hasDetail ? ' onclick="toggleConceptDetail(this)"' : '') + '>'
            +   '<div class="perspectives-concept-summary">'
            +     '<span class="perspectives-concept-text">' + escHtml(c.concept) + '</span>'
            +     typeBadge + levelBadge + peopleBadge
            +     '<span class="perspectives-agreement">' + c.services_count + ' service' + (c.services_count === 1 ? '' : 's') + ', ' + c.annotations_count + ' annotation' + (c.annotations_count === 1 ? '' : 's') + '</span>'
            +   '</div>'
            +   (hasDetail ? '<div class="perspectives-concept-detail" style="display:none;">' + variantHtml + (snippets ? '<div class="perspectives-snippets">' + snippets + '</div>' : '') + '</div>' : '')
            + '</div>';
    }
    list.innerHTML = html;
  }

  function toggleConceptDetail(el) {
    var detail = el.querySelector('.perspectives-concept-detail');
    if (!detail) return;
    var open = detail.style.display !== 'none';
    detail.style.display = open ? 'none' : '';
    el.classList.toggle('perspectives-concept--open', !open);
  }

  function renderThematic(data) {
    var block   = document.getElementById('perspectives-thematic');
    var list    = document.getElementById('perspectives-thematic-list');
    var concepts = data.thematic_concepts || [];
    if (concepts.length === 0) {
      block.style.display = 'none';
      return;
    }
    block.style.display = '';
    var html = '';
    for (var i = 0; i < concepts.length; i++) {
      var t = concepts[i];
      var hasSnippet = !!t.snippet;
      html += '<div class="perspectives-concept' + (hasSnippet ? ' perspectives-concept--expandable' : '') + '"' + (hasSnippet ? ' onclick="toggleConceptDetail(this)"' : '') + '>'
            +   '<div class="perspectives-concept-summary">'
            +     '<span class="perspectives-concept-text">' + escHtml(t.term) + '</span>'
            +     '<span class="perspectives-badge perspectives-badge--thematic">Thematic</span>'
            +     '<span class="perspectives-agreement">' + t.sources_count + ' source' + (t.sources_count === 1 ? '' : 's') + ', ' + t.descriptions_count + ' description' + (t.descriptions_count === 1 ? '' : 's') + '</span>'
            +   '</div>'
            +   (hasSnippet ? '<div class="perspectives-concept-detail" style="display:none;"><div class="perspectives-snippets">' + (t.example_annotations || []).map(evidenceHTML).join('') + '</div></div>' : '')
            + '</div>';
    }
    list.innerHTML = html;
  }

  function renderRelationships(data) {
    var block = document.getElementById('perspectives-relationships');
    var list = document.getElementById('perspectives-relationships-list');
    var families = data.concept_relationships || [];
    block.style.display = '';
    if (!families.length) {
      list.innerHTML = '<p class="perspectives-empty">No related terms were found in the current curated vocabulary. Individual observations remain available above.</p>';
      return;
    }
    list.innerHTML = families.map(function(family) {
      var synonyms = (family.synonym_groups || []).map(function(group) {
        return '<p class="perspectives-type-note">Linguistic equivalents: ' + group.terms.map(escHtml).join(', ') + '</p>';
      }).join('');
      return '<details class="research-concept-family"><summary>' + escHtml(capitalize(family.family))
        + ' — ' + family.terms.length + ' related terms</summary>' + synonyms
        + family.terms.map(function(term) {
          return '<details class="research-family-term"><summary>' + escHtml(term.term)
            + ' — ' + term.services.map(escHtml).join(', ') + ' · ' + term.annotations_count
            + ' annotation' + (term.annotations_count === 1 ? '' : 's') + '</summary>'
            + (term.example_annotations || []).map(function(e) {
              return '<div class="research-family-evidence"><span class="perspectives-type-note">'
                + escHtml(capitalize(e.type || 'annotation')) + '</span> ' + evidenceHTML(e) + '</div>';
            }).join('') + '</details>';
        }).join('') + '</details>';
    }).join('');
  }

  function renderObservations(data) {
    var section = document.getElementById('ai-observations-section');
    var container = document.getElementById('observations-categories');
    var obs = data.observations || {};
    var cats = Object.keys(obs);
    if (!section || cats.length === 0) {
      if (section) section.style.display = 'none';
      return;
    }
    section.style.display = '';

    var html = '';
    for (var i = 0; i < cats.length; i++) {
      var catKey = cats[i];
      var cat = obs[catKey];
      var catId = 'obs-cat-' + catKey;
      html += '<div class="obs-category">'
            +   '<div class="obs-category-toggle" onclick="toggleObsCategory(\'' + catKey + '\')">'
            +     '<span class="obs-category-label">' + escHtml(cat.label) + '</span>'
            +     '<span class="obs-category-count">' + cat.entries.length + ' phrase' + (cat.entries.length === 1 ? '' : 's') + '</span>'
            +   '</div>'
            +   '<div class="obs-category-body" id="' + catId + '" style="display:none;">'
            +     '<div class="obs-entries">';

      for (var j = 0; j < cat.entries.length; j++) {
        var e = cat.entries[j];
        var snippets = e.snippets || [];
        var hasDetail = snippets.length > 0;
        var srcBadges = e.sources.map(function(s) {
          return '<span class="obs-source-badge">' + escHtml(s) + '</span>';
        }).join('');
        var spatialBadge = '';
        if (e.spatially_detected) {
          var sd = e.spatially_detected;
          var spatialDetail = sd.per_service.map(function(ps) {
            return escHtml(ps.source) + ' ' + ps.instances + 'x';
          }).join(', ');
          spatialBadge = '<span class="obs-spatial-badge" title="Spatially detected: ' + escHtml(spatialDetail) + '">'
                       + '&#9635; ' + sd.total_instances + ' region' + (sd.total_instances !== 1 ? 's' : '')
                       + '</span>';
        }
        html += '<div class="obs-entry' + (hasDetail ? ' obs-entry--expandable' : '') + '"' + (hasDetail ? ' onclick="toggleConceptDetail(this)"' : '') + '>'
              +   '<div class="perspectives-concept-summary">'
              +     '<span class="obs-phrase">' + escHtml(e.phrase) + '</span>'
              +     '<span class="obs-entry-meta">'
              +       spatialBadge
              +       srcBadges
              +       '<span class="obs-count" title="' + e.occurrences_count + ' occurrences or region detections">' + e.annotations_count + ' annotation' + (e.annotations_count === 1 ? '' : 's') + '</span>'
              +     '</span>'
              +   '</div>'
              +   (hasDetail ? '<div class="perspectives-concept-detail" style="display:none;"><div class="perspectives-snippets mood-snippets">'
              +     snippets.slice(0, 5).map(function(s) {
                      var label = s.display_model && s.display_model !== s.source ? s.source + ' — ' + s.display_model : s.source;
                      return '<div class="mood-snippet">'
                           + '<span class="mood-snippet-source">' + escHtml(label) + '</span>'
                           + '<span class="mood-snippet-text">' + escHtml(s.text) + '</span>' + evidenceLink(s)
                           + '</div>';
                    }).join('')
              +     (snippets.length > 5 ? '<div class="mood-snippets-overflow" style="display:none;">' + snippets.slice(5).map(function(s) {
                      var label = s.display_model && s.display_model !== s.source ? s.source + ' — ' + s.display_model : s.source;
                      return '<div class="mood-snippet">'
                           + '<span class="mood-snippet-source">' + escHtml(label) + '</span>'
                           + '<span class="mood-snippet-text">' + escHtml(s.text) + '</span>' + evidenceLink(s)
                           + '</div>';
                    }).join('') + '</div><button class="mood-snippets-more" onclick="toggleMoodOverflow(event, this)">Show all ' + snippets.length + ' references</button>' : '')
              +   '</div></div>' : '')
              + '</div>';
      }

      html += '    </div>'  // .obs-entries
            + '  </div>'    // .obs-category-body
            + '</div>';     // .obs-category
    }
    container.innerHTML = html;
  }

  function renderMoodPalette(data) {
    var block = document.getElementById('perspectives-mood');
    var list = document.getElementById('perspectives-mood-list');
    var palette = data.mood_palette || [];
    if (palette.length === 0) {
      block.style.display = 'none';
      return;
    }
    block.style.display = '';
    var html = '<div class="mood-palette">';
    for (var i = 0; i < palette.length; i++) {
      var m = palette[i];
      var snippets = m.snippets || [];
      var hasDetail = snippets.length > 0;
      var sourceBadges = (m.sources || []).map(function(s) {
        return '<span class="obs-source-badge">' + escHtml(s) + '</span>';
      }).join('');
      html += '<div class="mood-term' + (hasDetail ? ' mood-term--expandable' : '') + '"' + (hasDetail ? ' onclick="toggleConceptDetail(this)"' : '') + '>'
            +   '<div class="perspectives-concept-summary">'
            +     '<span class="mood-term-text">' + escHtml(m.phrase) + '</span>'
            +     '<span class="mood-term-sources">' + sourceBadges + '</span>'
            +   '</div>'
            +   (hasDetail ? '<div class="perspectives-concept-detail" style="display:none;"><div class="perspectives-snippets mood-snippets">'
            +     snippets.slice(0, 5).map(function(s) {
                    var label = s.display_model && s.display_model !== s.source ? s.source + ' — ' + s.display_model : s.source;
                    return '<div class="mood-snippet">'
                         + '<span class="mood-snippet-source">' + escHtml(label) + '</span>'
                         + '<span class="mood-snippet-text">' + escHtml(s.text) + '</span>' + evidenceLink(s)
                         + '</div>';
                  }).join('')
            +     (snippets.length > 5 ? '<div class="mood-snippets-overflow" style="display:none;">' + snippets.slice(5).map(function(s) {
                    var label = s.display_model && s.display_model !== s.source ? s.source + ' — ' + s.display_model : s.source;
                    return '<div class="mood-snippet">'
                         + '<span class="mood-snippet-source">' + escHtml(label) + '</span>'
                         + '<span class="mood-snippet-text">' + escHtml(s.text) + '</span>' + evidenceLink(s)
                         + '</div>';
                  }).join('') + '</div><button class="mood-snippets-more" onclick="toggleMoodOverflow(event, this)">Show all ' + snippets.length + ' references</button>' : '')
            +   '</div></div>' : '')
            + '</div>';
    }
    html += '</div>';
    list.innerHTML = html;
  }

  function toggleMoodOverflow(event, btn) {
    event.stopPropagation();
    var overflow = btn.previousElementSibling;
    if (!overflow) return;
    var showing = overflow.style.display !== 'none';
    overflow.style.display = showing ? 'none' : '';
    if (showing) {
      btn.textContent = btn.dataset.showLabel;
    } else {
      btn.dataset.showLabel = btn.textContent;
      btn.textContent = 'Hide additional references';
    }
  }

  function toggleObsCategory(catKey) {
    var body = document.getElementById('obs-cat-' + catKey);
    if (!body) return;
    var category = body.parentElement;
    var open = body.style.display !== 'none';
    body.style.display = open ? 'none' : '';
    category.classList.toggle('obs-category--open', !open);
  }

  // -------------------------------------------------------------------------
  // Coverage Radar Chart (D3)
  // -------------------------------------------------------------------------
  function renderCoverageRadar(data) {
    window.renderResearchRadar(data);
  }

  function renderDownloadBtn(data) {
    var heading = document.querySelector('#ai-perspectives-section .attention-card-heading');
    if (!heading || document.getElementById('perspectives-download-btn')) return;
    var btn = document.createElement('a');
    btn.id        = 'perspectives-download-btn';
    btn.className = 'quickbar-btn perspectives-download-btn';
    btn.textContent = 'Download JSON';
    btn.href      = _perspectivesUrl;
    btn.download  = 'image-' + (data.imageid || '') + '-ai-perspectives.json';
    heading.appendChild(btn);
  }

  function escHtml(str) {
    return String(str || '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#39;');
  }

  function capitalize(str) {
    return str ? str.charAt(0).toUpperCase() + str.slice(1) : '';
  }

</script>

