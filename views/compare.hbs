<section class="object-view-panel">
  <a class="object-nav-header" href="/object/{{object_info.id}}">
    <img class="nav-logo" src="/images/artmuseumslogo.png"></img>
  </a>
  <div class="object-image-container">
    <div id="openseadragon1">
    </div>
    <div id="image-toolbar">
      <a id="zoom-in" href="#zoom-in" title="Zoom in"><i class="fa fa-search-plus toolbar-button"></i></a>
      <a id="zoom-out" href="#zoom-out" title="Zoom out"><i class="fa fa-search-minus toolbar-button"></i></a>
    </div>
  </div>
</section>

<section class="object-info-panel">
  <div class="content">
    <div>
      <h2>Compare Descriptions</h2>
      {{#if image_summary}}<p class="image-summary">{{{image_summary}}}</p>{{/if}}
    </div>

    {{#if descriptions_list}}

    {{! Pre-render all description bodies into hidden elements for JS to read }}
    <div style="display:none" aria-hidden="true">
      {{#each descriptions_list}}
        <div class="desc-data" data-key="{{key}}" data-source="{{source}}" data-model="{{#if display_model}}{{display_model}}{{else}}{{model}}{{/if}}" data-date="{{createdate}}" data-age="{{age}}" data-model-released="{{model_released}}" data-usage-input="{{#if cost}}{{cost.input}}{{/if}}" data-usage-output="{{#if cost}}{{cost.output}}{{/if}}" data-stats-total="{{#if stats}}{{stats.total}}{{/if}}" data-stats-density="{{#if stats}}{{stats.lexicalDensity}}{{/if}}" data-stats-ttr="{{#if stats}}{{stats.ttr}}{{/if}}" data-stats-hapax="{{#if stats}}{{stats.hapaxRatio}}{{/if}}" data-stats-sent="{{#if stats}}{{stats.avgSentLen}}{{/if}}">
          {{#if isHuman}}
            <p>{{body}}</p>
          {{else}}
            {{{markdown body}}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="compare-quickbar">
      <span class="compare-quickbar-label">Quick compare</span>
      <button class="quickbar-btn" id="preset-length" title="Compare the shortest and longest descriptions by word count">Shortest vs. Longest</button>
      <button class="quickbar-btn" id="preset-cost" title="Compare descriptions by total token usage">Cheapest vs. Most Expensive</button>
      <button class="quickbar-btn" id="preset-age" title="Compare the oldest and newest AI descriptions by model release date">Oldest vs. Newest</button>
    </div>

    <div class="compare-outer">
      <div class="compare-layout">
        {{! Row 1: controls }}
        <div class="compare-col-a">
          <span class="compare-select-label">Model A</span>
          <select id="select-a" class="compare-select">
            {{#each descriptions_list}}
              <option value="{{key}}">{{source}}{{#if display_model}} — {{display_model}}{{else}}{{#if model}} — {{model}}{{/if}}{{/if}}</option>
            {{/each}}
          </select>
        </div>
        <div class="compare-col-mid"></div>
        <div class="compare-col-b">
          <span class="compare-select-label">Model B</span>
          <select id="select-b" class="compare-select">
            {{#each descriptions_list}}
              <option value="{{key}}">{{source}}{{#if display_model}} — {{display_model}}{{else}}{{#if model}} — {{model}}{{/if}}{{/if}}</option>
            {{/each}}
          </select>
        </div>

        {{! Row 2: panels }}
        <div class="compare-col-a compare-panel">
          <div class="compare-panel-header" id="header-a"></div>
          <div class="compare-text" id="panel-a"></div>
        </div>
        <div class="compare-col-mid"></div>
        <div class="compare-col-b compare-panel">
          <div class="compare-panel-header" id="header-b"></div>
          <div class="compare-text" id="panel-b"></div>
        </div>
      </div>

      <div class="compare-sidebar" id="compare-sidebar">
        <span class="sidebar-header">Similarity</span>

        <div class="compare-similarity">
          <div class="similarity-row">
            <span class="similarity-row-label">TF-IDF</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="tfidf-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="tfidf-label"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Word overlap</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="overlap-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="overlap-label"></span>
            <span class="similarity-counts" id="similarity-counts"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Sentence</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="sentence-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="sentence-label"></span>
            <span class="similarity-counts" id="sentence-counts"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Semantic</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="semantic-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="semantic-label">—</span>
          </div>
        </div>

        <div class="compare-keyphrases">
          <span class="sidebar-group-label">Key phrases</span>
          <div id="keyphrases-output"></div>
        </div>


        <div class="compare-actions">
          <span class="sidebar-group-label">Actions</span>
          <div>
            <button id="diff-toggle" class="quickbar-btn">Show Diff</button>
            <button id="density-toggle" class="quickbar-btn">Hide Density</button>
            <button id="cost-toggle" class="quickbar-btn">Hide Cost</button>
          </div>
        </div>

      </div>
    </div>{{! /.compare-outer }}

    {{else}}
      <p class="compare-empty">No descriptions available for this object.</p>
    {{/if}}

  </div>
</section>

<script src="/javascripts/openseadragon/openseadragon.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/diff@5/dist/diff.min.js"></script>
<script src="/vocabularies/stopwords.js"></script>
<script src="/javascripts/textanalysis.js"></script>

<script type="text/javascript">
  var viewer = OpenSeadragon({
      id: "openseadragon1",
      prefixUrl: "../javascripts/openseadragon/images/",
      toolbar: "image-toolbar",
      zoomInButton: "zoom-in",
      zoomOutButton: "zoom-out",
      {{#if object_info.imagepermissionlevel}}
      maxZoomLevel: 1,
      {{/if}}
      tileSources: [
        "{{display_image.baseimageurl}}/info.json"
      ]
  });

  var diffActive = false;
  var densityVisible = true;
  var costVisible = true;

  function applyPanelVisibility() {
    document.querySelectorAll('.panel-stats-section--density').forEach(function(el) {
      el.style.display = densityVisible ? '' : 'none';
    });
    document.querySelectorAll('.panel-stats-section--cost').forEach(function(el) {
      el.style.display = costVisible ? '' : 'none';
    });
  }

  function getDescData(key) {
    return document.querySelector('.desc-data[data-key="' + key + '"]');
  }

  function renderPanel(panelEl, headerEl, key) {
    var el = getDescData(key);
    if (!el) return;
    panelEl.innerHTML = el.innerHTML;
    var source = el.dataset.source;
    var model = el.dataset.model;
    var date = el.dataset.date;
    var html = '';
    if (date) {
      var age = el.dataset.age || '';
      html += '<span class="header-date">Description generated on ' + escapeHtml(date);
      if (age) html += ' <span class="header-age">(' + age + ')</span>';
      html += '</span>';
    }
    var usageInput  = el.dataset.usageInput;
    var usageOutput = el.dataset.usageOutput;
    var stats = null;
    if (el.dataset.statsTotal) {
      stats = {
        total:          parseInt(el.dataset.statsTotal,   10),
        lexicalDensity: parseInt(el.dataset.statsDensity, 10),
        ttr:            parseInt(el.dataset.statsTtr,     10),
        hapaxRatio:     parseInt(el.dataset.statsHapax,   10),
        avgSentLen:     parseInt(el.dataset.statsSent,    10)
      };
    }
    if (stats) {
      html += '<div class="panel-stats-section panel-stats-section--density">'
        + '<span class="sidebar-group-label panel-stats-label">Information Density</span>'
        + '<div class="panel-stats">'
        + '<span class="panel-stat" title="Content words / total words">Lexical density <strong>' + stats.lexicalDensity + '%</strong></span>'
        + '<span class="panel-stat" title="Unique words / total words">Vocab diversity <strong>' + stats.ttr + '%</strong></span>'
        + '<span class="panel-stat" title="Words appearing once / total words">Specificity <strong>' + stats.hapaxRatio + '%</strong></span>'
        + '<span class="panel-stat" title="Average words per sentence">Avg sentence <strong>' + stats.avgSentLen + ' words</strong></span>'
        + '<span class="panel-stat" title="Total word count">Length <strong>' + stats.total + ' words</strong></span>'
        + '</div>'
        + '</div>';
    }
    if (source === 'Human') {
      html += '<div class="panel-stats-section panel-stats-section--cost">'
        + '<span class="sidebar-group-label panel-stats-label">Cost</span>'
        + '<div class="panel-stats panel-stats--tokens">'
        + '<span class="panel-stat" title="Time spent writing">Total hours <strong>&gt;0</strong></span>'
        + '</div>'
        + '</div>';
    } else if (usageInput || usageOutput) {
      var totalTokens = "-";
      if  (parseInt(usageInput) && parseInt(usageOutput)) {
        totalTokens = parseInt(usageInput, 10) + parseInt(usageOutput, 10);
      }
      html += '<div class="panel-stats-section panel-stats-section--cost">'
        + '<span class="sidebar-group-label panel-stats-label">Cost</span>'
        + '<div class="panel-stats panel-stats--tokens">'
        + '<span class="panel-stat" title="Tokens sent to the model">Input tokens <strong>' + (usageInput || '—') + '</strong></span>'
        + '<span class="panel-stat" title="Tokens generated by the model">Output tokens <strong>' + (usageOutput || '—') + '</strong></span>'
        + (totalTokens !== null ? '<span class="panel-stat" title="Total tokens used">Total tokens <strong>' + totalTokens + '</strong></span>' : '')
        + '</div>'
        + '</div>';
    }
    headerEl.innerHTML = html;
  }

  function updateSimilarity() {
    var textA = document.getElementById('panel-a').innerText;
    var textB = document.getElementById('panel-b').innerText;
    var tfidf = tfidfCosine(textA, textB);
    var overlap = wordOverlap(textA, textB);
    var sentence = sentenceOverlap(textA, textB);
    var phrases = keyPhrases(textA, textB);
    document.getElementById('tfidf-fill').style.width = tfidf + '%';
    document.getElementById('tfidf-label').textContent = tfidf + '%';
    document.getElementById('overlap-fill').style.width = overlap.pct + '%';
    document.getElementById('overlap-label').textContent = overlap.pct + '%';
    document.getElementById('similarity-counts').textContent =
      '(' + overlap.shared + ' shared / ' + overlap.uniqueA + ' only A / ' + overlap.uniqueB + ' only B)';
    document.getElementById('sentence-fill').style.width = sentence.pct + '%';
    document.getElementById('sentence-label').textContent = sentence.pct + '%';
    document.getElementById('sentence-counts').textContent =
      '(' + sentence.matchedA + ' of ' + sentence.totalA + ' in A / ' + sentence.matchedB + ' of ' + sentence.totalB + ' in B)';
    renderKeyPhrases(phrases);
    document.getElementById('semantic-label').textContent = 'Computing…';
    document.getElementById('semantic-fill').style.width = '0%';
    if (window.__updateSemantic) window.__updateSemantic(textA, textB);
  }

  function renderKeyPhrases(result) {
    var out = document.getElementById('keyphrases-output');
    if (!out) return;
    var html = '';
    result.shared.forEach(function(t) {
      html += '<span class="phrase-chip phrase-chip--shared">' + escapeHtml(t) + '</span>';
    });
    result.onlyA.forEach(function(t) {
      html += '<span class="phrase-chip phrase-chip--a">' + escapeHtml(t) + '</span>';
    });
    result.onlyB.forEach(function(t) {
      html += '<span class="phrase-chip phrase-chip--b">' + escapeHtml(t) + '</span>';
    });
    out.innerHTML = html || '<span class="similarity-counts">No significant terms found</span>';
  }

  function applyDiff() {
    var panelA = document.getElementById('panel-a');
    var panelB = document.getElementById('panel-b');
    var textA = panelA.innerText;
    var textB = panelB.innerText;

    var diffResult = Diff.diffWords(textA, textB);

    var htmlA = '';
    var htmlB = '';
    diffResult.forEach(function(part) {
      if (part.removed) {
        htmlA += '<span class="diff-remove">' + escapeHtml(part.value) + '</span>';
      } else if (part.added) {
        htmlB += '<span class="diff-add">' + escapeHtml(part.value) + '</span>';
      } else {
        var escaped = escapeHtml(part.value);
        htmlA += escaped;
        htmlB += escaped;
      }
    });

    panelA.innerHTML = htmlA;
    panelB.innerHTML = htmlB;
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function clearDiff() {
    var keyA = document.getElementById('select-a').value;
    var keyB = document.getElementById('select-b').value;
    renderPanel(document.getElementById('panel-a'), document.getElementById('header-a'), keyA);
    renderPanel(document.getElementById('panel-b'), document.getElementById('header-b'), keyB);
    applyPanelVisibility();
  }

  function update() {
    clearDiff();
    updateSimilarity();
    if (diffActive) applyDiff();
  }

  document.addEventListener('DOMContentLoaded', function() {
    var selectA = document.getElementById('select-a');
    var selectB = document.getElementById('select-b');
    if (!selectA) return;

    // Pre-select second option for B if available
    if (selectB.options.length > 1) {
      selectB.selectedIndex = 1;
    }

    update();

    selectA.addEventListener('change', update);
    selectB.addEventListener('change', update);

    document.getElementById('diff-toggle').addEventListener('click', function() {
      diffActive = !diffActive;
      this.textContent = diffActive ? 'Hide Diff' : 'Show Diff';
      if (diffActive) {
        applyDiff();
      } else {
        clearDiff();
      }
    });

    document.getElementById('density-toggle').addEventListener('click', function() {
      densityVisible = !densityVisible;
      this.textContent = densityVisible ? 'Hide Density' : 'Show Density';
      applyPanelVisibility();
    });

    document.getElementById('cost-toggle').addEventListener('click', function() {
      costVisible = !costVisible;
      this.textContent = costVisible ? 'Hide Cost' : 'Show Cost';
      applyPanelVisibility();
    });

    // ── Side panel presets ──────────────────────────────────────

    var CAPTION_MODELS = ['BLIP Caption', 'BLIP-2 Caption', 'CLIP Caption'];

    function getAllDescs() {
      return Array.from(document.querySelectorAll('.desc-data'))
        .filter(function(el) { return CAPTION_MODELS.indexOf(el.dataset.model) === -1; })
        .map(function(el) {
          var text = el.textContent || '';
          var words = text.trim().split(/\s+/).filter(Boolean).length;
          var inp = el.dataset.usageInput  ? parseInt(el.dataset.usageInput,  10) : null;
          var out = el.dataset.usageOutput ? parseInt(el.dataset.usageOutput, 10) : null;
          return {
            key:          el.dataset.key,
            source:       el.dataset.source,
            date:         el.dataset.date,
            modelReleased: el.dataset.modelReleased || null,
            words:        words,
            tokens:       (inp !== null && out !== null) ? inp + out : null
          };
        });
    }

    function applyPreset(keyA, keyB) {
      selectA.value = keyA;
      selectB.value = keyB;
      update();
    }

    document.getElementById('preset-length').addEventListener('click', function() {
      var d = getAllDescs().slice().sort(function(a, b) { return a.words - b.words; });
      if (d.length >= 2) applyPreset(d[0].key, d[d.length - 1].key);
    });

    document.getElementById('preset-cost').addEventListener('click', function() {
      var d = getAllDescs().filter(function(x) { return x.tokens !== null; })
                           .sort(function(a, b) { return a.tokens - b.tokens; });
      if (d.length >= 2) applyPreset(d[0].key, d[d.length - 1].key);
    });

    document.getElementById('preset-age').addEventListener('click', function() {
      var d = getAllDescs().filter(function(x) { return x.modelReleased; })
                           .sort(function(a, b) { return a.modelReleased < b.modelReleased ? -1 : 1; });
      if (d.length >= 2) applyPreset(d[0].key, d[d.length - 1].key);
    });

    (function auditPresets() {
      var withCost = getAllDescs().filter(function(x) { return x.tokens !== null; });
      if (withCost.length < 2) {
        document.getElementById('preset-cost').classList.add('quickbar-btn--disabled');
      }
      var withRelease = getAllDescs().filter(function(x) { return x.modelReleased; });
      if (withRelease.length < 2) {
        document.getElementById('preset-age').classList.add('quickbar-btn--disabled');
      }
      if (getAllDescs().length < 2) {
        document.querySelectorAll('.quickbar-btn').forEach(function(b) {
          b.classList.add('quickbar-btn--disabled');
        });
      }
    })();

  });
</script>

<script type="module">
  import { pipeline, cos_sim } from 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2/dist/transformers.min.js';

  var embedder = null;

  async function getEmbedder() {
    if (!embedder) {
      embedder = await pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2', { quantized: true });
    }
    return embedder;
  }

  async function updateSemanticSimilarity(textA, textB) {
    try {
      var emb = await getEmbedder();
      var outA = await emb(textA, { pooling: 'mean', normalize: true });
      var outB = await emb(textB, { pooling: 'mean', normalize: true });
      var sim = cos_sim(Array.from(outA.data), Array.from(outB.data));
      var pct = Math.round(Math.max(0, sim) * 100);
      document.getElementById('semantic-fill').style.width = pct + '%';
      document.getElementById('semantic-label').textContent = pct + '%';
    } catch(e) {
      document.getElementById('semantic-label').textContent = 'Error';
    }
  }

  window.__updateSemantic = function(textA, textB) {
    updateSemanticSimilarity(textA, textB);
  };
</script>
