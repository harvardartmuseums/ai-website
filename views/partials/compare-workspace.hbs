    {{#if descriptions_list}}

    {{! Pre-render all description bodies into hidden elements for JS to read }}
    <div style="display:none" aria-hidden="true">
      {{#each descriptions_list}}
        <div class="desc-data" data-key="{{key}}" data-annotation-id="{{annotation_id}}" data-scope="{{scope}}" data-source-raw="{{source_raw}}" data-source="{{source}}" data-model="{{#if display_model}}{{display_model}}{{else}}{{model}}{{/if}}" data-date="{{createdate}}" data-age="{{age}}" data-model-released="{{model_released}}" data-usage-input="{{#if cost}}{{cost.input}}{{/if}}" data-usage-output="{{#if cost}}{{cost.output}}{{/if}}" data-stats-total="{{#if stats}}{{stats.total}}{{/if}}" data-stats-density="{{#if stats}}{{stats.lexicalDensity}}{{/if}}" data-stats-ttr="{{#if stats}}{{stats.ttr}}{{/if}}" data-stats-hapax="{{#if stats}}{{stats.hapaxRatio}}{{/if}}" data-stats-sent="{{#if stats}}{{stats.avgSentLen}}{{/if}}">
          {{#if isHuman}}
            <p>{{body}}</p>
          {{else}}
            {{{markdown body}}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="compare-quickbar">
      <span class="compare-quickbar-label">Quick compare</span>
      <button class="quickbar-btn" id="preset-length" title="Compare the shortest and longest descriptions by word count">Shortest vs. Longest</button>
      <button class="quickbar-btn" id="preset-cost" title="Compare descriptions by total token usage">Fewest vs. Most tokens</button>
      <button class="quickbar-btn" id="preset-age" title="Compare the oldest and newest AI descriptions by model release date">Oldest vs. Newest</button>
    </div>

    <div class="compare-outer">
      <div class="compare-layout">
        {{! Row 1: controls }}
        <div class="compare-col-a">
          <label for="select-a" class="compare-select-label">Output A</label>
          <select id="select-a" class="compare-select">
            {{#each descriptions_list}}
              <option value="{{key}}">{{#if isHuman}}{{scope}} — {{/if}}{{source}}{{#if display_model}} — {{display_model}}{{else}}{{#if model}} — {{model}}{{/if}}{{/if}}{{#unless isHuman}} · {{createdate}} · Annotation {{annotation_id}}{{/unless}}</option>
            {{/each}}
          </select>
        </div>
        <div class="compare-col-mid"></div>
        <div class="compare-col-b">
          <label for="select-b" class="compare-select-label">Output B or reference</label>
          <select id="select-b" class="compare-select">
            {{#each descriptions_list}}
              <option value="{{key}}">{{#if isHuman}}{{scope}} — {{/if}}{{source}}{{#if display_model}} — {{display_model}}{{else}}{{#if model}} — {{model}}{{/if}}{{/if}}{{#unless isHuman}} · {{createdate}} · Annotation {{annotation_id}}{{/unless}}</option>
            {{/each}}
          </select>
        </div>

        {{! Row 2: panels }}
        <div class="compare-col-a compare-panel">
          <div class="compare-panel-header" id="header-a"></div>
          <div class="compare-text" id="panel-a"></div>
        </div>
        <div class="compare-col-mid"></div>
        <div class="compare-col-b compare-panel">
          <div class="compare-panel-header" id="header-b"></div>
          <div class="compare-text" id="panel-b"></div>
        </div>
      </div>

      <div class="compare-sidebar" id="compare-sidebar">
        <span class="sidebar-header">Similarity</span>

        <div class="compare-similarity">
          <div class="similarity-row">
            <span class="similarity-row-label">TF-IDF</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="tfidf-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="tfidf-label"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Word overlap</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="overlap-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="overlap-label"></span>
            <span class="similarity-counts" id="similarity-counts"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Sentence</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="sentence-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="sentence-label"></span>
            <span class="similarity-counts" id="sentence-counts"></span>
          </div>
          <div class="similarity-row">
            <span class="similarity-row-label">Semantic</span>
            <div class="similarity-bar-wrap">
              <div class="similarity-bar-fill" id="semantic-fill" style="width:0%"></div>
            </div>
            <span class="similarity-label" id="semantic-label">—</span>
          </div>
        </div>

        <div class="compare-keyphrases">
          <span class="sidebar-group-label">Key phrases</span>
          <div id="keyphrases-output"></div>
        </div>


        <div class="compare-actions">
          <span class="sidebar-group-label">Actions</span>
          <div>
            <button id="diff-toggle" class="quickbar-btn">Show Diff</button>
            <button id="density-toggle" class="quickbar-btn">Show language statistics</button>
            <button id="cost-toggle" class="quickbar-btn">Show tokens</button>
          </div>
        </div>

      </div>
    </div>{{! /.compare-outer }}

    {{else}}
      <p class="compare-empty">No descriptions available for this image.</p>
    {{/if}}

