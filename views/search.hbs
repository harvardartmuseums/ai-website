<section>
    {{#if error}}
      <div class="content">
        <h2>{{title}}</h2>
        <p>Try searching for a new keyword</p>
      </div>
      {{> startexploring}}
    {{else}}
      <div class="content-search-results">
        <div>
          <h2>{{title}}</h2>
          <h3>{{subtitle}}</h3>
          <h3>{{#if (eq tag_stats.source_count.value total_sources)}}
            The term is used by all {{total_sources}} sources.
            {{else}}
            The term is used by {{tag_stats.source_count.value}} of {{total_sources}} sources.
            {{/if}}
             {{source_summary}}
          </h3>
          {{#if term_distribution_summary}}<p>{{term_distribution_summary}}</p>{{/if}}
          <p>
          <details>
            <summary>Show Statistics</summary>
              <div id="confidence-plot">
                <p>Distribution of Confidence</p>
              </div>
              <div id="source-plot">
                <p>Distribution of Sources</p>
              </div>
          </details>
          </p>
          {{!-- <details>
            <summary>Filter by Source and Model</summary>
                <div class="search-filters">
                  {{#each tag_stats.by_source.buckets}}
                    <div class="filter-source{{#if (eq key ../active_source)}} filter-source--active{{/if}}">
                      {{#if (eq key ../active_source)}}
                        <a href="/search/{{../tag}}/1" class="filter-source-label active">&#x2715; {{key}} <span class="filter-count">({{doc_count}})</span></a>
                        {{#if by_model.buckets}}
                          <div class="filter-models">
                            <ul>
                            {{#if ../active_model}}
                              <li><a href="/search/{{../tag}}/1?source={{../active_source}}" class="filter-chip active">&#x2715; {{../active_model}}</a></li>
                            {{/if}}
                            {{#each by_model.buckets}}
                              {{#unless (eq key ../../active_model)}}
                                <li><a href="/search/{{../../tag}}/1?source={{../key}}&model={{key}}" class="filter-chip">{{key}} <span class="filter-count">({{doc_count}})</span></a></li>
                              {{/unless}}
                            {{/each}}
                            </ul>
                          </div>
                        {{/if}}
                      {{else}}
                        <a href="/search/{{../tag}}/1?source={{key}}" class="filter-source-label">{{key}} <span class="filter-count">({{doc_count}})</span></a>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
          </details> --}}
          <p>Sort by:
            {{#if (eq active_sort 'frequency')}}
              <a href="/search/{{tag}}/1{{filterParamsNoSort}}">Confidence</a> &middot; <strong>Frequency</strong>
            {{else}}
              <strong>Confidence</strong> &middot; <a href="/search/{{tag}}/1{{filterParamsNoSort}}{{#if filterParamsNoSort}}&sort=frequency{{else}}?sort=frequency{{/if}}">Frequency</a>
            {{/if}}
          </p>
        </div>
        <div id="search-results">
          {{#each object_results}}
            <div class="object-search-result">
              {{#if (ne objectid -1)}}<a href="/object/{{objectid}}/image/{{imagehit.imageid}}">{{/if}}
                <div class="search-result-box">
                  <div class="search-result-image-wrap">
                    <div class="search-result-image-box" style="background-image:url({{imagehit.baseimageurl}}:THUMBNAIL)"></div>
                    <div class="search-result-overlay">
                      <div class="overlay-content">
                        <h4>{{title}}</h4>
                        <h5>
                          {{#each people}}
                            {{name}}
                          {{/each}}
                        </h5>
                      </div>
                    </div>
                  </div>

                    {{#if min_confidence}}
                      <div class="search-confidence-bar">
                        {{#if (eq min_confidence max_confidence)}}
                          <div class="search-range-bar search-range-bar--point" style="{{#if (eq max_confidence 100)}}right:0{{else}}left:{{max_confidence}}%{{/if}}" title="{{max_confidence}}%"></div>
                        {{else}}
                          <div class="search-range-bar" style="left:{{min_confidence}}%; width:{{subtract max_confidence min_confidence}}%" title="{{min_confidence}}% – {{max_confidence}}%"></div>
                        {{/if}}
                      </div>
                      <div class="confidence-label"><span class="confidence-label-text">confidence</span> {{#if (eq min_confidence max_confidence)}}{{max_confidence}}%{{else}}{{min_confidence}}% – {{max_confidence}}%{{/if}}</div>
                    {{else}}
                      {{#if max_confidence}}
                        <div class="search-confidence-bar">
                          <div class="search-red-bar" style="width:{{max_confidence}}%"></div>
                        </div>
                        <div class="confidence-label"><span class="confidence-label-text">confidence</span> {{max_confidence}}%</div>
                      {{else}}
                        <div class="search-confidence-bar"></div>
                        <div class="confidence-label"><span class="confidence-label-text">confidence</span> &ndash;%</div>
                      {{/if}}
                    {{/if}}
                    <div class="frequency-label"><span class="confidence-label-text">frequency</span> {{frequency}} annotations · ~{{term_frequency}} uses</div>


                  <div class="search-result-confidence">

                    <div class="confidence-content">
                      <table class="confidence-table">
                        {{#each sources_summary}}
                          <tr>
                            <td>{{source}}</td>
                            <td class="table-confidence">
                              {{#if has_confidence}}
                                {{#if (eq min max)}}{{max}}<sup>%</sup>
                                {{else}}{{min}}–{{max}}<sup>%</sup>
                                {{/if}}
                              {{else}}{{count}}<sup>×</sup>
                              {{/if}}
                            </td>
                          </tr>
                        {{/each}}
                      </table>
                    </div>
                  </div>
                </div>
              {{#if (ne objectid -1)}}</a>{{/if}}
            </div>
          {{/each}}
        </div>
      </div>
      <div class="pagination">
        <a id="firstpage" href="/search/{{tag}}/1{{filterParams}}"><i class="fa fa-angle-double-left"></i></a>
        <a id="previouspage" href="/search/{{tag}}/{{tag_results_info.pagenumber.previouspage}}{{filterParams}}"><i class="fa fa-angle-left"></i></a>
        <div id="pagenumbers"></div>
        <a id="nextpage" href="/search/{{tag}}/{{tag_results_info.pagenumber.nextpage}}{{filterParams}}"><i class="fa fa-angle-right"></i></a>
        <a id="lastpage" href="/search/{{tag}}/{{tag_results_info.pages}}{{filterParams}}"><i class="fa fa-angle-double-right"></i></a>
      </div>
    {{/if}}

</section>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    if ({{tag_results_info.page}} == 1) {
      document.getElementById('previouspage').style.visibility = "hidden"
      document.getElementById('firstpage').style.visibility = "hidden"
    }

    if ({{tag_results_info.page}} == {{tag_results_info.pages}}) {
      document.getElementById('nextpage').style.visibility = "hidden"
      document.getElementById('lastpage').style.visibility = "hidden"
    }

    if ({{tag_results_info.pages}} > 1) {
      let pagenumberarray = pageNumbers({{tag_results_info.page}}, {{tag_results_info.pages}});

      pagenumberarray.forEach(function(pagenumber) {
        if (pagenumber == {{tag_results_info.page}}) {
          document.getElementById("pagenumbers").innerHTML+=
            '<a href="/search/{{tag}}/' + pagenumber + '{{filterParams}}" class="active">' + pagenumber + '</a>'
        } else {
          document.getElementById("pagenumbers").innerHTML+=
            '<a href="/search/{{tag}}/' + pagenumber + '{{filterParams}}">' + pagenumber + '</a>'
        }
      })
    }

    plotConfidence();
    plotSources();

  }, false);

  function pageNumbers(currentpage, totalpages) {
    let pagenumberarray = [];

    if (currentpage == 1) {
      // add next 4 pages      
      pagenumberarray = [1, 2, 3, 4, 5]

    } else if (currentpage == 2) {
      // add first page, add next 3 pages
      pagenumberarray = [1, 2, 3, 4, 5]

    } else if (currentpage == (totalpages - 1)) {
      // add last page, add previous 3 pages
      pagenumberarray = [(currentpage - 3), (currentpage - 2), (currentpage - 1), currentpage, (currentpage + 1)]

    } else if (currentpage == totalpages) {
      // add previous 4 pages
      pagenumberarray = [(currentpage - 4), (currentpage - 3), (currentpage - 2), (currentpage - 1), currentpage]

    } else {
      // add previous 2 pages, add next 2 pages
      pagenumberarray = [(currentpage - 2), (currentpage - 1), currentpage, (currentpage + 1), (currentpage + 2)]
    }

    pagenumberarray = pagenumberarray.filter(number => number <= totalpages);
    return pagenumberarray.filter(number => number > 0)
  }

  function plotConfidence() {
    const d = [
    {{#each tag_stats.confidences.buckets}}
      { "occurence":{{doc_count}}, "confidence":{{key}} },
    {{/each}}    
    ];
    d.splice(0,1);
    
    const plot = Plot.plot({
        style: {display: "inline"}, 
        marks: [
          Plot.frame(),
          Plot.rectY(d, {x: "confidence", y: "occurence",tip: true, interval: 0.05}),
          Plot.axisX({label: "low", labelAnchor : "left", labelArrow: "down"}),
          Plot.axisX({label: "degree of confidence", labelAnchor: "center", labelArrow: "none"}),
          Plot.axisX({label: "high", labelAnchor : "right", labelArrow : "up"}),

        ],
        height: 250,
        width: 500,
        y: {grid: true},
        marginTop: 20, // 🌶 if you don't set the margins, the defaults flip the scales bottom-up
        marginBottom: 40,
        marginLeft: 50,
        marginRight: 20
      });

    const div = document.getElementById("confidence-plot");
    div.append(plot);
  }

  function plotSources() {
    const d = [
    {{#each tag_stats.by_source.buckets}}
      { "occurence":{{doc_count}}, "source":"{{key}}"},
    {{/each}}    
    ];

    const plot = Plot.plot({
        style: {display: "inline"}, 
        y: {grid: true},
        marks: [
          Plot.frame(),
          Plot.barY(d, {y: "occurence", x: "source", tip: true }),
          Plot.axisX({labelAnchor: "center", labelArrow: "none", lineWidth: 6}),
        ],
        height: 250,
        width: 800,
        marginTop: 20, // 🌶 if you don't set the margins, the defaults flip the scales bottom-up
        marginBottom: 40,
        marginLeft: 50,
        marginRight: 20
      });

    const div = document.getElementById("source-plot");
    div.append(plot);    
  }
</script>
